{{- $pages := where .Site.RegularPages "Type" "writeups" -}}

[
{{- range $index, $page := $pages -}}
{{- if $index }},{{ end }}
{
    "title": {{ $page.Title | jsonify }},
    "permalink": {{ $page.Permalink | jsonify }},
    "platform": {{ $page.Params.platform | jsonify }},
    "difficulty": {{ $page.Params.difficulty | jsonify }},
    "image": {{ $page.Params.image | jsonify }}
}
{{- end -}}
]